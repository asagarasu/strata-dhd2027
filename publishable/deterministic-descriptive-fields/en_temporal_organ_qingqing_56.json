     "text": "Her red-powdered face.",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 11,
     "text": "Small, small,",
