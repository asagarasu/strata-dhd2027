   },
   "lines": [
    {
     "line_no": 1,
     "text": "Blue, blue is the grass about the river",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 2,
     "text": "And the willows have overfilled the close garden.",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 3,
     "text": "And within, the mistress, in the midmost of her youth,",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 4,
     "text": "White, white of face, hesitates, passing the door.",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 5,
     "text": "Slender, she puts forth a slender hand,",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 6,
     "text": "And she was a courtezan in the old days,",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 7,
     "text": "And she has married a sot,",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 8,
     "text": "Who now goes drunkenly out",
     "row_fired_words": [
      {
       "word": "now",
       "row_classes": [
        "ephemeral"
       ],
       "also_bygone_informational": false,
       "senses": [
        {
         "synset": "now.n.01",
         "pole": "ephemeral",
         "route": "ephemeral:momentary",
         "gloss_clause": "the momentary present",
         "snippet": "momentary",
         "metaphor": false,
         "abstract_head": false
        }
       ],
       "bygone_senses_informational": []
      }
     ],
     "bygone_informational_words": [],
     "line_row_class_rollup": {
      "ephemeral": 1
     },
     "n_row_fired_words": 1,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 9,
     "text": "And leaves her too much alone.",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    }
   ]
