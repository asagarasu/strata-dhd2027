   "lines": [
    {
     "line_no": 1,
     "text": "Green grows the grass upon the bank,",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 2,
     "text": "The willow-shoots are long and lank;",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 3,
     "text": "A lady in a glistening gown",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 4,
     "text": "Opens the casement and looks down.",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 5,
     "text": "The roses on her cheek blush bright,",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 6,
     "text": "Her rounded arm is dazzling white;",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 7,
     "text": "A singing-girl in early life,",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 8,
     "text": "And now a careless roué's wife....",
     "row_fired_words": [
      {
       "word": "now",
       "row_classes": [
        "ephemeral"
       ],
       "also_bygone_informational": false,
       "senses": [
