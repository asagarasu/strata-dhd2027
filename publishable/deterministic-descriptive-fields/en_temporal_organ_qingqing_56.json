         "synset": "now.n.01",
         "pole": "ephemeral",
         "route": "ephemeral:momentary",
         "gloss_clause": "the momentary present",
         "snippet": "momentary",
         "metaphor": false,
         "abstract_head": false
        }
       ],
       "bygone_senses_informational": []
      }
     ],
     "bygone_informational_words": [],
     "line_row_class_rollup": {
      "ephemeral": 1
     },
     "n_row_fired_words": 1,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 9,
     "text": "Ah, if he does not mind his own,",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 10,
     "text": "He'll find some day the bird has flown!",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
