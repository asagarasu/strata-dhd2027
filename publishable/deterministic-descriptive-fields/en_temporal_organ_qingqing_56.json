     "text": "She puts out her pale hand.",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
     "line_no": 13,
     "text": "Once she was a dancing-house girl.",
     "row_fired_words": [],
     "bygone_informational_words": [],
     "line_row_class_rollup": {},
     "n_row_fired_words": 0,
     "n_bygone_informational_words": 0
    },
    {
