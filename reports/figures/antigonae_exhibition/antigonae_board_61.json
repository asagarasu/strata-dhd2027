 "seat_colour_states": {
  "grc:sophocles_storr": [
   {
    "line": 1,
    "text": "ὦ κοινὸν αὐτάδελφον Ἰσμήνης κάρα,",
    "state": "latent",
    "receipts": [
     "καλχαίνω"
    ],
    "starred": true,
    "channel": "latent-written(LSJ etymon, EXHIBITION)"
   },
   {
    "line": 2,
    "text": "ἆρ᾽ οἶσθ᾽ ὅ τι Ζεὺς τῶν ἀπ᾽ Οἰδίπου κακῶν",
    "state": "present*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 3,
    "text": "ὁποῖον οὐχὶ νῷν ἔτι ζώσαιν τελεῖ;",
    "state": "present*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 4,
    "text": "οὐδὲν γὰρ οὔτ᾽ ἀλγεινὸν οὔτ᾽ ἄτης ἄτερ",
    "state": "present*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 5,
    "text": "οὔτ᾽ αἰσχρὸν οὔτ᾽ ἄτιμόν ἐσθ᾽, ὁποῖον οὐ",
    "state": "silent*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 6,
    "text": "τῶν σῶν τε κἀμῶν οὐκ ὄπωπ᾽ ἐγὼ κακῶν.",
    "state": "silent*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 7,
    "text": "καὶ νῦν τί τοῦτ᾽ αὖ φασι πανδήμῳ πόλει",
    "state": "silent*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 8,
    "text": "κήρυγμα θεῖναι τὸν στρατηγὸν ἀρτίως;",
    "state": "latent",
    "receipts": [
     "καλχαίνω"
    ],
    "starred": true,
    "channel": "latent-written(LSJ etymon, EXHIBITION)"
   },
   {
    "line": 9,
    "text": "ἔχεις τι κεἰσήκουσας; ἤ σε λανθάνει",
    "state": "silent*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 10,
    "text": "πρὸς τοὺς φίλους στείχοντα τῶν ἐχθρῶν κακά;",
    "state": "silent*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 11,
    "text": "ἐμοὶ μὲν οὐδεὶς μῦθος, Ἀντιγόνη φίλων",
    "state": "silent*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 12,
    "text": "οὔθ᾽ ἡδὺς οὔτ᾽ ἀλγεινὸς ἵκετ᾽ ἐξ ὅτου",
    "state": "silent*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 13,
    "text": "δυοῖν ἀδελφοῖν ἐστερήθημεν δύο,",
    "state": "present*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 14,
    "text": "μιᾷ θανόντοιν ἡμέρᾳ διπλῇ χερί:",
    "state": "present*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 15,
    "text": "ἐπεὶ δὲ φροῦδός ἐστιν Ἀργείων στρατὸς",
    "state": "present*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 16,
    "text": "ἐν νυκτὶ τῇ νῦν, οὐδὲν οἶδ᾽ ὑπέρτερον,",
    "state": "silent*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 17,
    "text": "οὔτ᾽ εὐτυχοῦσα μᾶλλον οὔτ᾽ ἀτωμένη.",
    "state": "present*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 18,
    "text": "ᾔδη καλῶς, καί σ᾽ ἐκτὸς αὐλείων πυλῶν",
    "state": "latent",
    "receipts": [
     "καλχαίνω"
    ],
    "starred": true,
    "channel": "latent-written(LSJ etymon, EXHIBITION)"
   },
   {
    "line": 19,
    "text": "τοῦδ᾽ οὕνεκ᾽ ἐξέπεμπον, ὡς μόνη κλύοις.",
    "state": "present*",
    "receipts": [],
    "starred": true,
    "channel": "2-state starred (grc: no shelf)"
   },
   {
    "line": 20,
    "text": "τί δ᾽ ἔστι; δηλοῖς γάρ τι καλχαίνουσ᾽ ἔπος.",
    "state": "latent",
    "receipts": [
     "καλχαίνω"
    ],
    "starred": true,
    "channel": "latent-written(LSJ etymon, EXHIBITION)"
   }
  ],
  "de:hoelderlin_1804": [
   {
    "line": 1,
    "text": "Gemeinsamschwesterliches! o Ismenes Haupt!",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 2,
    "text": "Weilst du etwas, das nicht der Erde Vater",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 3,
    "text": "Erfuhr, mit uns, die wir bis hieher leben,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 4,
    "text": "Ein Nennbares, seit Oedipus gehascht ward?",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 5,
    "text": "Nicht eine traur'ge Arbeit, auch kein Irrsaal,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 6,
    "text": "Und schändlich ist, und ehrlos nirgend eines,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 7,
    "text": "Das ich in deinem, meinem Unglück nicht gesehn.",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 8,
    "text": "Jetzt aber, ahnest du das, was der Feldherr",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 9,
    "text": "Uns kundgethan, in offner Stadt, so eben?",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 10,
    "text": "Hast du gehört es? oder weist du nicht,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 11,
    "text": "Wie auf die Lieben kommet Feindesübel?",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 12,
    "text": "Nicht kam ein Wort zu mir, Antigonä, von Lieben,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 13,
    "text": "Kein liebliches und auch kein trauriges, seitdem",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 14,
    "text": "Die beyden Brüder beyde wir verloren;",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 15,
    "text": "Die starben, Einen Tag, von zweyen Händen;",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 16,
    "text": "Seit aber fort das Heer von Argos ist,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 17,
    "text": "Vergangne Nacht, weiß ich nichts weiter mehr,",
    "state": "stated",
    "receipts": [
     "weiß"
    ],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 18,
    "text": "Und bin nicht glücklicher und nicht betrübter.",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 19,
    "text": "Das dacht' ich wohl und rief aus dem Hofthor",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 20,
    "text": "Darum, daß du's besonders hören könntest.",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 21,
    "text": "Was ist's, du scheinst ein rothes Wort zu färben?",
    "state": "stated",
    "receipts": [
     "rot"
    ],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   }
  ],
  "de:donner_1868": [
   {
    "line": 1,
    "text": "ANTIGONE.",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 2,
    "text": "Ismene, traute Schwester, vielgeliebtes Haupt,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 3,
    "text": "Weißt du von einem Leide, das vom Vater her",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 4,
    "text": "Zeus nicht an uns vollendet, die wir leben noch?",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 5,
    "text": "Denn keinen Jammer gibt es, nichts Entsetzliches,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 6,
    "text": "Nichts Arges, nichts Schmachvolles, was ich nicht bereits",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 7,
    "text": "In deinem und in meinem Ungemach geseh'n.",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 8,
    "text": "Und welche Botschaft, sagt man, ließ jezt eben erst",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 9,
    "text": "Der Herrscher wieder allem Volk verkündigen?",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 10,
    "text": "Vernahmst du's, weißt du's, oder blieb dir unbekannt,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 11,
    "text": "Daß unsern Lieben Böses naht von Feindesmacht?",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 12,
    "text": "Mir wurde keine Kunde mehr, Antigone,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 13,
    "text": "Von unsern Lieben, frohe nicht noch traurige,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 14,
    "text": "Seitdem das Paar der Brüder uns entrissen ward,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 15,
    "text": "Die Eines Tages fielen durch zwiefachen Mord.",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 16,
    "text": "Und seit in dieser jüngsten Nacht sich Argos' Heer",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 17,
    "text": "Zur Flucht gewendet, wurde mir nichts weiter kund,",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 18,
    "text": "Nicht, ob mir mehr des Glückes, ob des Leides ward.",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 19,
    "text": "ANTIGONE.",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 20,
    "text": "Wohl wußt' ich das, und führte deßhalb dich heraus",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 21,
    "text": "Zum Thor des Hofes, dir allein es kundzuthun.",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   },
   {
    "line": 22,
    "text": "Was hast du? Düster wogt in dir ein schweres Wort",
    "state": "silent",
    "receipts": [],
    "starred": false,
    "channel": "descriptive-boolean(de_color)"
   }
  ]
 },
